    given-names: Nahyan M.
    affiliation: Geosyntec Consultants; University of Waterloo
    email: nahyan.rana@geosyntec.com
    # orcid: https://orcid.org/0000-0000-0000-0000
version: "0.16"
license: MIT
repository-code: https://github.com/NahyanRana/dlbreach-dashboard
url: https://nahyanrana.github.io/dlbreach-dashboard/
keywords:
  - dam breach
  - DLBreach
  - embankment dams
  - Monte Carlo
  - breach outflow hydrograph
  - dam safety
  - Streamlit
