# ---------------------------------------------------------------------
# Allowlist: everything is ignored unless it is listed below. A new file
# is only published after it has been added here on purpose, so project
# inputs, outputs, reports and spreadsheets cannot be committed by
# accident.
# ---------------------------------------------------------------------
/*
!/.gitignore
!/.gitattributes
!/.github/
!/.streamlit/
!/app.py
!/dlbreach_*.py
!/test_core.py
!/test_app_headless.py
!/requirements.txt
!/README.md
!/SETUP.md
!/PUBLISHING.md
!/CHANGELOG.md
!/CONTRIBUTING.md
!/NOTICE.md
!/TAILINGS_TODO.md
!/LICENSE
!/CITATION.cff
!/Launch DLBreach Dashboard.bat
!/dev/
!/docs/
!/test_cases/

# Only the Streamlit display settings, never secrets
/.streamlit/*
!/.streamlit/config.toml

# Only the published worked examples
/test_cases/*
!/test_cases/README.md
!/test_cases/T[0-9]_water_*.json
!/test_cases/T[0-9]_water_*.txt
!/test_cases/solid_waste_paused/
!/test_cases/wu_2016/
/test_cases/solid_waste_paused/*
!/test_cases/solid_waste_paused/S[0-9]_solid_*.json
!/test_cases/solid_waste_paused/S[0-9]_solid_*.txt
# Prof. Wu's validation inputs (from his DLBreach page) and their data files
/test_cases/wu_2016/*
!/test_cases/wu_2016/*_cards*.txt
!/test_cases/wu_2016/Mecox_*.txt

# Developer folder: tools and the stand-in fixture only
/dev/*
!/dev/README.md
!/dev/*.py
!/dev/fixtures/
/dev/fixtures/*
!/dev/fixtures/standin_T1.out
/dev/*private*

# Docs: text and the README images only
/docs/*
!/docs/*.md
!/docs/images/
/docs/images/*
!/docs/images/*.png

# Anywhere, as a second line of defence
__pycache__/
*.py[cod]
*.exe
Run4*
*private*
*.xlsx
*.xlsm
*.xls
*.docx
*.pdf
*.zip
